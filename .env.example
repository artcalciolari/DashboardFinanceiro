# Local environment
DB_USER=change_me
DB_PASSWORD=change_me
DB_NAME=change_me

# Required only when starting the backend directly with `pnpm run dev`.
# DATABASE_URL=postgresql://change_me:change_me@localhost:5432/change_me
# HOST=127.0.0.1

# Frontend API URL
# Leave empty to use the Docker reverse proxy.
# Use http://localhost:3001 for direct local development.
VITE_API_URL=

# Local Compose binds port 3000. The remote override binds port 80 and requires
# deploy/.htpasswd. Use 0.0.0.0 only on a trusted LAN or behind a TLS proxy.
DASHBOARD_BIND_ADDRESS=127.0.0.1
BUSINESS_TIME_ZONE=America/Sao_Paulo

# Optional comma-separated origins when opening the dashboard from another local address.
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
