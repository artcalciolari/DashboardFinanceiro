generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                  String      @id @default(cuid())
  name                String
  type                AccountType
  openingBalanceCents Int         @default(0)
  color               String      @default("#3B82F6")
  creditLimitCents    Int? // Para cartão: limite total informativo, em centavos
  closingDay          Int? // Para cartão: dia de fechamento da fatura
  dueDay              Int? // Para cartão: dia de vencimento da fatura

  transactions      Transaction[]
  installmentGroups InstallmentGroup[]
  subscriptions     Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AccountType {
  BANK_ACCOUNT
  CREDIT_CARD
  CASH
  INVESTMENT
}

model Category {
  id    String       @id @default(cuid())
  name  String
  type  CategoryType
  color String       @default("#10B981")
  icon  String?

  transactions      Transaction[]
  alerts            Alert[]
  installmentGroups InstallmentGroup[]
  subscriptions     Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Transaction {
  id            String          @id @default(cuid())
  description   String
  amountCents   Int
  type          TransactionType
  date          DateTime // Data real da compra
  effectiveDate DateTime // Data efetiva (ajustada pelo fechamento do cartão)

  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  installmentGroupId String?
  installmentGroup   InstallmentGroup? @relation(fields: [installmentGroupId], references: [id], onDelete: SetNull)
  installmentNumber  Int?
  totalInstallments  Int?
  subscriptionId     String?
  subscription       Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionYear   Int?
  subscriptionMonth  Int?

  isThirdParty   Boolean @default(false)
  thirdPartyName String?
  isReimbursed   Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, subscriptionYear, subscriptionMonth])
  @@index([effectiveDate, id])
  @@index([accountId, effectiveDate])
  @@index([categoryId, effectiveDate])
  @@index([installmentGroupId, installmentNumber])
}

enum TransactionType {
  INCOME
  EXPENSE
}

model InstallmentGroup {
  id               String    @id @default(cuid())
  description      String
  totalAmountCents Int
  installmentCount Int
  startDate        DateTime
  isThirdParty     Boolean   @default(false)
  thirdPartyName   String?
  isReimbursed     Boolean   @default(false)
  isCancelled      Boolean   @default(false)
  cancelledAt      DateTime?

  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([categoryId])
}

model Subscription {
  id             String    @id @default(cuid())
  name           String
  amountCents    Int
  startDate      DateTime
  endDate        DateTime?
  billingDay     Int
  isActive       Boolean   @default(true)
  isThirdParty   Boolean   @default(false)
  thirdPartyName String?
  isReimbursed   Boolean   @default(false)
  notes          String?

  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startDate])
  @@index([accountId])
  @@index([categoryId])
}

model Alert {
  id               String      @id @default(cuid())
  name             String
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  limitAmountCents Int
  period           AlertPeriod
  isActive         Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

enum AlertPeriod {
  MONTHLY
  WEEKLY
}
